{
  "name": "calliope-docs",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "pack": "node ./prebuild/packStaticFolder/index.cjs",
    "dev": "node ./prebuild/packStaticFolder/index.cjs && node prebuild/generate-subpage-files.cjs && vite dev",
    "build": "node ./prebuild/packStaticFolder/index.cjs && node prebuild/generate-subpage-files.cjs && vite build",
    "deploy": "node ./prebuild/packStaticFolder/index.cjs && vite build && npx svelte-sitemap --domain https://docs.calliope.cc --ignore '/1/**'",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.7",
    "@eslint/js": "^9.22.0",
    "@inlang/cli": "^3.0.0",
    "@inlang/paraglide-js": "2.0.12",
    "@chromatic-com/storybook": "^4.1.1",
    "chromatic": "^11.27.0",
    "@storybook/addon-svelte-csf": "5.0.10",
    "@storybook/sveltekit": "^9.1.15",
    "@sveltejs/adapter-cloudflare": "^5.0.3",
    "@sveltejs/adapter-vercel": "^5.6.3",
    "@sveltejs/enhanced-img": "^0.4.4",
    "@sveltejs/kit": "^2.19.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.15.0",
    "mdsvex": "^0.12.3",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "sass": "^1.93.2",
    "sass-embedded": "^1.85.1",
    "storybook": "^9.1.15",
    "super-sitemap": "^1.0.3",
    "svelte": "^5.22.6",
    "svelte-check": "^4.1.5",
    "svelte-preprocess": "^6.0.3",
    "sveltekit-embed": "^0.0.18",
    "typescript": "^5.8.2",
    "unplugin-icons": "^22.1.0",
    "vite": "^5.4.14",
    "eslint-plugin-storybook": "9.1.15",
    "@storybook/addon-docs": "^9.1.15"
  },
  "dependencies": {
    "@iconify/json": "^2.2.314",
    "@inlang/paraglide-js": "^2.0.12",
    "@inlang/paraglide-sveltekit": "^0.16.1",
    "@rodneylab/sveltekit-components": "^3.0.2",
    "@sveltejs/adapter-static": "^3.0.8",
    "body-scroll-lock": "4.0.0-beta.0",
    "fast-exif": "^2.0.1",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "just-camel-case": "^6.2.0",
    "mdsvex-relative-images": "github:Amerlander/mdsvex-relative-images",
    "photoswipe": "^5.4.4",
    "rehype-slug": "^6.0.0",
    "rehype-unwrap-images": "^1.0.0",
    "remark-video": "^0.10.0",
    "svelte-persisted-store": "^0.12.0",
    "unist-util-visit": "^5.0.0"
  }
}
